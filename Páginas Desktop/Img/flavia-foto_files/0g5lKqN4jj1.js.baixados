[43]===Symbol.for("react.memo_cache_sentinel")?(de=s._(/*BTDS*/"Isso \u00e9 muito longo para enviar. Encurte e tente novamente."),me=s._(/*BTDS*/"Cole a resposta da IA aqui"),n[43]=de,n[44]=me):(de=n[43],me=n[44]);var pe;n[45]===Symbol.for("react.memo_cache_sentinel")?(pe=s._(/*BTDS*/"Cole suas informa\u00e7\u00f5es aqui"),n[45]=pe):pe=n[45];var _e;n[46]!==A?(_e=d.jsx(r("WAWebWDSRichTextField.react"),{error:A,errorText:de,label:me,onValueChange:H,placeholder:pe,rows:b,testid:"hatch_generate_memory_paste_field"}),n[46]=A,n[47]=_e):_e=n[47];var fe;n[48]!==ce||n[49]!==_e?(fe=d.jsx("div",babelHelpers.extends({},ee,{"data-testid":"hatch_generate_memory_scroll_body",children:d.jsxs("div",babelHelpers.extends({},te,{"data-testid":"hatch_generate_memory_content",children:[ne,ce,_e]}))})),n[48]=ce,n[49]=_e,n[50]=fe):fe=n[50];var ge;n[51]===Symbol.for("react.memo_cache_sentinel")?(ge=d.jsx(r("WDSText.react"),{colorName:"contentDeemphasized",testid:"hatch_generate_memory_footnote",textAlign:"center",type:"Body3",xstyle:L.footnote,children:s._(/*BTDS*/"{agent name} ler\u00e1 essa informa\u00e7\u00e3o e lembrar\u00e1 os fatos permanentes. Essa n\u00e3o \u00e9 uma c\u00f3pia literal.",[s._param("agent name",d.jsx(r("WAWebHatchBotName.react"),{}))])}),n[51]=ge):ge=n[51];var he;return n[52]!==X||n[53]!==fe?(he=d.jsxs(r("WDSDialog.react"),{closeButton:!1,footer:X,headerMedia:J,headerType:"expressive",layoutType:"expressive",onDismiss:o("WDSDialogBridge").closeWDSDialog,open:!0,size:"md",testid:"hatch_generate_memory_dialog",title:Z,children:[fe,ge]}),n[52]=X,n[53]=fe,n[54]=he):he=n[54],he}function k(e){o("WALogger").WARN(u||(u=babelHelpers.taggedTemplateLiteralLoose(["hatch-import-memory/open-chat-threw"]))).catching(r("getErrorSafe")(e)).sendLogs("hatch-import-memory-open-chat-threw")}function I(){return s._(/*BTDS*/"Voc\u00ea est\u00e1 me ajudando a migrar contexto de um assistente de IA para outro. Seu trabalho \u00e9 compilar, a partir das nossas conversas anteriores, um instant\u00e2neo de mem\u00f3ria port\u00e1til do que voc\u00ea sabe sobre mim com certeza. O resultado ser\u00e1 copiado palavra por palavra para a mem\u00f3ria de uma nova IA, portanto, a qualidade \u00e9 mais importante do que a quantidade.\n\nREGRAS DO RESULTADO\n- Crie um bloco de Markdown usando os cabe\u00e7alhos de se\u00e7\u00e3o abaixo. Omita as se\u00e7\u00f5es sobre as quais voc\u00ea n\u00e3o tem informa\u00e7\u00f5es concretas. N\u00e3o invente informa\u00e7\u00f5es para preench\u00ea-las.\n\n- Use a terceira pessoa (\"o usu\u00e1rio\", \"a pessoa\") para se referir a mim dentro de cada item. N\u00e3o use pronomes em primeira pessoa para se referir a voc\u00ea.\n- Separe um fato por item. N\u00e3o inclua transi\u00e7\u00f5es, narrativas ou ressalvas fora do item.\n- Caso as informa\u00e7\u00f5es de um item n\u00e3o sejam exatas, insira \"(deduzido)\" ao final do item.\n- Ignore frases isoladas, a menos que sejam claramente importantes. D\u00ea prefer\u00eancia a fatos mencionados em v\u00e1rias conversas.\n- Ignore fatos desatualizados que tenham mais de {number of months} meses, a menos que sejam dados de identidade (nome, localiza\u00e7\u00e3o, profiss\u00e3o).\n- Ignore informa\u00e7\u00f5es confidenciais (condi\u00e7\u00f5es de sa\u00fade, dados financeiros, problemas de relacionamento, sa\u00fade mental), a menos que eu tenha pedido explicitamente para voc\u00ea se lembrar delas.\n- Limite m\u00e1ximo: {number of words} palavras. Priorize a densidade, n\u00e3o a cobertura.\n\nSE\u00c7\u00d5ES\n\n## Identidade\nNome, pronomes, faixa et\u00e1ria, cidade\/pa\u00eds atual, fuso hor\u00e1rio, idiomas falados.\n\n## Profiss\u00e3o e trabalho\nFun\u00e7\u00e3o, empresa ou trabalho aut\u00f4nomo, setor, equipe ou fun\u00e7\u00e3o, responsabilidades principais. Stack tecnol\u00f3gico e ferramentas usadas diariamente, se conhecidas.\n\n## Prefer\u00eancias de comunica\u00e7\u00e3o\nTom desejado (casual\/formal, direto\/indireto). Comprimento de resposta preferido (curta\/m\u00e9dio\/longa). Prefer\u00eancias de formato de resultado (Markdown, texto simples, blocos de c\u00f3digo, tabelas). Uso de emojis: sim\/n\u00e3o. Se quer explica\u00e7\u00f5es ou apenas respostas. Qualquer estrutura ou palavra que tenham pedido para evitar.\n\n## Pessoas recorrentes\nParceiro(a), filhos, familiares pr\u00f3ximos, amigos, colegas que s\u00e3o mencionados regularmente. Nome + relacionamento + detalhes relevantes (idade, papel, interesses).\n\n## Sa\u00fade e alimenta\u00e7\u00e3o\nAlergias, restri\u00e7\u00f5es alimentares (por exemplo, vegetariano, sem gl\u00faten), necessidades de acessibilidade. Inclua somente coisas que foram ditas pela pr\u00f3pria pessoa.\n\n## Interesses e hobbies\nT\u00f3picos que a pessoa sempre volta a mencionar. Hobbies. Esportes, m\u00fasica, jogos, prefer\u00eancias de leitura.\n\n## Projetos cont\u00ednuos\nProjetos pessoais ou profissionais ativos para os quais voc\u00ea recebeu um pedido de ajuda. Estado, meta e limita\u00e7\u00f5es.\n\n## Estilo e valores de trabalho\nComo a pessoa toma decis\u00f5es, o que a motiva, o que a frustra, a abordagem geral dela ao aprendizado e ao trabalho. Coisas que a pessoa pediu explicitamente para voc\u00ea fazer ou n\u00e3o fazer ao ajud\u00e1-la.\n\n## Ferramentas e ambiente\nDispositivos, sistemas operacionais, apps, servi\u00e7os, idiomas, estruturas usadas com frequ\u00eancia.\n\n## Outros dados relevantes\nQualquer informa\u00e7\u00e3o importante que n\u00e3o se encaixe nos itens anteriores e provavelmente n\u00e3o mudar\u00e1 no pr\u00f3ximo ano.",[s._param("number of months",h),s._param("number of words",y)])}function T(e){return e.trim()!==""&&o("WAWebSendHatchMemoryImport").buildHatchMemoryImportMessage(e)==null}l.default=E}),226);
